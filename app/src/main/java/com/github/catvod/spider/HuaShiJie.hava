package com.github.catvod.spider;

import android.content.Context;
import android.text.TextUtils;
import android.util.Log;

import com.github.catvod.crawler.Spider;
import com.google.gson.Gson;
import com.google.gson.JsonArray;
import com.google.gson.JsonElement;
import com.google.gson.JsonObject;

import java.util.HashMap;
import java.util.List;
import java.util.concurrent.TimeUnit;

import okhttp3.OkHttpClient;
import okhttp3.Request;
import okhttp3.Response;

public class HuaShiJie extends Spider {

    private static final String TAG      = "HuaShiJie";
    private static final String API_BASE = "https://api.huashijie.tv/api.php/";
    private static final String UA       = "okhttp/5.0.0-alpha.14";

    private OkHttpClient client;
    private final Gson gson = new Gson();

    @Override
    public void init(Context context, String extend) throws Exception {
        client = new OkHttpClient.Builder()
                .connectTimeout(10, TimeUnit.SECONDS)
                .readTimeout(15, TimeUnit.SECONDS)
                .followRedirects(true)
                .build();
    }

    // =============================================================
    //  首页分类
    //  GET v2.vod/androidtypes
    //  返回 {"code":200,"msg":"success","data":[
    //          {"type_id":1,"type_name":"电影","classes":[...],"areas":[...],"years":[...]},
    //          ...
    //        ]}
    // =============================================================
    @Override
    public String homeContent(boolean filter) throws Exception {
        String body = httpGet(API_BASE + "v2.vod/androidtypes");
        Log.d(TAG, "androidtypes raw=" + body);

        JsonArray classes  = new JsonArray();
        JsonObject filters = new JsonObject();

        JsonObject root = parseObject(body);
        if (root == null || !codeOk(root)) {
            Log.e(TAG, "androidtypes bad response");
            return emptyHome();
        }

        JsonArray data = (root.has("data") && root.get("data").isJsonArray())
                ? root.getAsJsonArray("data") : null;

        if (data != null) {
            for (JsonElement e : data) {
                if (!e.isJsonObject()) continue;
                JsonObject item = e.getAsJsonObject();

                String tid  = firstNonEmpty(optStr(item, "type_id"), optStr(item, "id"));
                String name = firstNonEmpty(optStr(item, "type_name"), optStr(item, "name"));
                if (TextUtils.isEmpty(tid) || TextUtils.isEmpty(name)) continue;

                // 跳过 type_id=35 直播（classes/areas/years 都是 [""]）
                if ("35".equals(tid)) continue;

                JsonObject cls = new JsonObject();
                cls.addProperty("type_id",  tid);
                cls.addProperty("type_name", name);
                classes.add(cls);

                if (filter) {
                    JsonArray dims = buildFilterDims(item);
                    if (dims.size() > 0) filters.add(tid, dims);
                }
            }
        }

        Log.d(TAG, "homeContent class=" + classes.size()
                + ", filters=" + filters.size());

        JsonObject out = new JsonObject();
        out.add("class", classes);
        if (filter && filters.size() > 0) out.add("filters", filters);
        return out.toString();
    }

    /** 按真实 classes/areas/years 生成 3 个筛选维度 */
    private JsonArray buildFilterDims(JsonObject item) {
        JsonArray dims = new JsonArray();

        JsonArray cs = safeStringArray(item, "classes");
        if (cs.size() > 0) dims.add(filterDim("class", "剧情", cs));

        JsonArray as = safeStringArray(item, "areas");
        if (as.size() > 0) dims.add(filterDim("area", "地区", as));

        JsonArray ys = safeStringArray(item, "years");
        if (ys.size() > 0) dims.add(filterDim("year", "年份", ys));

        return dims;
    }

    /** 数组里过滤空串 */
    private JsonArray safeStringArray(JsonObject o, String key) {
        JsonArray out = new JsonArray();
        if (o == null || !o.has(key) || !o.get(key).isJsonArray()) return out;
        for (JsonElement e : o.getAsJsonArray(key)) {
            if (e == null || e.isJsonNull()) continue;
            String v = e.getAsString();
            if (!TextUtils.isEmpty(v)) out.add(v);
        }
        return out;
    }

    /** {"key":"area","name":"地区","value":[{"n":"全部","v":""},{"n":"大陆","v":"大陆"}]} */
    private JsonObject filterDim(String key, String name, JsonArray values) {
        JsonObject d = new JsonObject();
        d.addProperty("key",  key);
        d.addProperty("name", name);
        JsonArray vs = new JsonArray();

        JsonObject all = new JsonObject();
        all.addProperty("n", "全部");
        all.addProperty("v", "");
        vs.add(all);

        for (JsonElement e : values) {
            JsonObject v = new JsonObject();
            v.addProperty("n", e.getAsString());
            v.addProperty("v", e.getAsString());
            vs.add(v);
        }
        d.add("value", vs);
        return d;
    }

    private String emptyHome() {
        JsonObject out = new JsonObject();
        out.add("class", new JsonArray());
        return out.toString();
    }

    // =============================================================
    //  分类列表 / 筛选
    //  GET v2.vod/androidfilter?type_id=&page=&area=&year=&class=
    // =============================================================
    @Override
    public String categoryContent(String tid, String pg, boolean filter,
                                  HashMap<String, String> extend) throws Exception {
        StringBuilder url = new StringBuilder(API_BASE)
                .append("v2.vod/androidfilter")
                .append("?type_id=").append(enc(tid))
                .append("&page=").append(enc(TextUtils.isEmpty(pg) ? "1" : pg));

        if (extend != null) {
            String area = extend.get("area");
            String year = extend.get("year");
            String cls  = extend.get("class");
            if (!TextUtils.isEmpty(area)) url.append("&area=").append(enc(area));
            if (!TextUtils.isEmpty(year)) url.append("&year=").append(enc(year));
            if (!TextUtils.isEmpty(cls))  url.append("&class=").append(enc(cls));
        }

        String body = httpGet(url.toString());
        Log.d(TAG, "androidfilter raw=" + body);
        return listResult(body);
    }

    // =============================================================
    //  详情
    //  GET v2.vod/androiddetail?vod_id=
    //  data.urls[] = [{type,key,url(m3u8直链)}]
    // =============================================================
    @Override
    public String detailContent(List<String> ids) throws Exception {
        if (ids == null || ids.isEmpty()) return "";
        String vodId = ids.get(0);

        String body = httpGet(API_BASE + "v2.vod/androiddetail?vod_id=" + enc(vodId));
        Log.d(TAG, "androiddetail raw=" + body);

        JsonObject root = parseObject(body);
        if (root == null || !codeOk(root)) return "";

        JsonObject data = (root.has("data") && root.get("data").isJsonObject())
                ? root.getAsJsonObject("data") : null;
        if (data == null) return "";

        JsonObject vod = new JsonObject();
        vod.addProperty("vod_id",       optStr(data, "id"));
        vod.addProperty("vod_name",     optStr(data, "name"));
        vod.addProperty("vod_pic",      optStr(data, "pic"));
        vod.addProperty("vod_year",     optStr(data, "year"));
        vod.addProperty("vod_area",     optStr(data, "area"));
        vod.addProperty("vod_director", optStr(data, "director"));
        vod.addProperty("vod_actor",    optStr(data, "actor"));
        vod.addProperty("vod_content",  optStr(data, "content"));
        vod.addProperty("vod_remarks",  firstNonEmpty(optStr(data, "state"), optStr(data, "updateInfo")));

        StringBuilder fromBuf = new StringBuilder();
        StringBuilder urlBuf  = new StringBuilder();

        JsonArray urls = (data.has("urls") && data.get("urls").isJsonArray())
                ? data.getAsJsonArray("urls") : null;

        if (urls != null) {
            for (int i = 0; i < urls.size(); i++) {
                JsonElement el = urls.get(i);
                if (!el.isJsonObject()) continue;
                JsonObject u = el.getAsJsonObject();
                String lineName = firstNonEmpty(optStr(u, "key"), optStr(u, "type"), "线路" + (i + 1));
                String link     = optStr(u, "url");
                if (TextUtils.isEmpty(link)) continue;

                if (fromBuf.length() > 0) fromBuf.append("$$$");
                if (urlBuf.length() > 0)  urlBuf.append("$$$");

                fromBuf.append(lineName);
                urlBuf.append("正片").append("$").append(link);
            }
        }

        vod.addProperty("vod_play_from", fromBuf.toString());
        vod.addProperty("vod_play_url",  urlBuf.toString());

        JsonArray list = new JsonArray();
        list.add(vod);
        JsonObject out = new JsonObject();
        out.add("list", list);
        return out.toString();
    }

    // =============================================================
    //  搜索
    //  GET v2.vod/androidsearch10086?wd=&page=
    // =============================================================
    @Override
    public String searchContent(String key, boolean quick) throws Exception {
        return searchContent(key, quick, "1");
    }

    @Override
    public String searchContent(String key, boolean quick, String pg) throws Exception {
        String body = httpGet(API_BASE + "v2.vod/androidsearch10086?wd="
                + enc(key) + "&page=" + enc(TextUtils.isEmpty(pg) ? "1" : pg));
        Log.d(TAG, "androidsearch raw=" + body);
        return listResult(body);
    }

    // =============================================================
    //  播放：详情已是明文 m3u8，直接 parse=0
    // =============================================================
    @Override
    public String playerContent(String flag, String id, List<String> vipFlags) throws Exception {
        JsonObject out = new JsonObject();
        out.addProperty("parse", 0);
        out.addProperty("url",   id);
        out.addProperty("jx",    0);
        return out.toString();
    }

    // =============================================================
    //  工具
    // =============================================================

    private String httpGet(String url) {
        Request req = new Request.Builder()
                .url(url)
                .header("User-Agent", UA)
                .header("Accept", "*/*")
                .get().build();
        try (Response resp = client.newCall(req).execute()) {
            return resp.body() == null ? "" : resp.body().string();
        } catch (Exception e) {
            Log.e(TAG, "httpGet fail url=" + url, e);
            return "";
        }
    }

    private JsonObject parseObject(String body) {
        if (TextUtils.isEmpty(body)) return null;
        try {
            JsonElement el = gson.fromJson(body, JsonElement.class);
            if (el != null && el.isJsonObject()) return el.getAsJsonObject();
        } catch (Exception ignore) { }
        return null;
    }

    private boolean codeOk(JsonObject root) {
        if (root == null) return false;
        if (!root.has("code") || root.get("code").isJsonNull()) return true;
        try { return root.get("code").getAsInt() == 200; }
        catch (Exception e) { return true; }
    }

    /** 兼容 顶层数组 / {data:[]} / {list:[]} / {data:{list:[]}} */
    private JsonArray asArray(String body) {
        if (TextUtils.isEmpty(body)) return null;
        try {
            JsonElement el = gson.fromJson(body, JsonElement.class);
            return asArray(el);
        } catch (Exception ignore) { return null; }
    }

    private JsonArray asArray(JsonElement el) {
        if (el == null || el.isJsonNull()) return null;
        if (el.isJsonArray()) return el.getAsJsonArray();
        if (el.isJsonObject()) {
            JsonObject o = el.getAsJsonObject();
            for (String k : new String[]{"data", "list", "result", "items"}) {
                if (!o.has(k) || o.get(k).isJsonNull()) continue;
                JsonArray r = asArray(o.get(k));
                if (r != null) return r;
            }
        }
        return null;
    }

    /** 列表接口 -> {list:[Vod], pagecount:N} */
    private String listResult(String body) {
        JsonObject out = new JsonObject();
        JsonArray listArr = new JsonArray();

        JsonObject root = parseObject(body);
        if (root != null && !codeOk(root)) {
            out.add("list", listArr);
            out.addProperty("pagecount", 1);
            return out.toString();
        }

        JsonArray data = asArray(body);
        if (data != null) {
            for (JsonElement e : data) {
                if (!e.isJsonObject()) continue;
                JsonObject it = e.getAsJsonObject();
                JsonObject v = new JsonObject();
                v.addProperty("vod_id",      firstNonEmpty(optStr(it, "id"), optStr(it, "vod_id")));
                v.addProperty("vod_name",    firstNonEmpty(optStr(it, "name"), optStr(it, "vod_name")));
                v.addProperty("vod_pic",     firstNonEmpty(optStr(it, "pic"), optStr(it, "vod_pic")));
                v.addProperty("vod_remarks", firstNonEmpty(optStr(it, "updateInfo"), optStr(it, "state"), optStr(it, "remarks")));
                v.addProperty("vod_year",    optStr(it, "year"));
                v.addProperty("vod_area",    optStr(it, "area"));
                v.addProperty("type_name",   firstNonEmpty(optStr(it, "className"), optStr(it, "type_name")));
                listArr.add(v);
            }
        }
        out.add("list", listArr);

        int pageCount = 1;
        if (root != null) {
            JsonObject d = (root.has("data") && root.get("data").isJsonObject())
                    ? root.getAsJsonObject("data") : root;
            if (d.has("total") && !d.get("total").isJsonNull()) {
                try { pageCount = Math.max(1, (d.get("total").getAsInt() + 19) / 20); }
                catch (Exception ignore) { }
            }
        }
        out.addProperty("pagecount", pageCount);
        return out.toString();
    }

    private static String optStr(JsonObject o, String key) {
        if (o == null || !o.has(key) || o.get(key).isJsonNull()) return "";
        try { return o.get(key).getAsString(); } catch (Exception e) { return ""; }
    }

    private static String firstNonEmpty(String... arr) {
        for (String s : arr) if (!TextUtils.isEmpty(s)) return s;
        return "";
    }

    private static String enc(String s) {
        if (s == null) return "";
        try { return java.net.URLEncoder.encode(s, "UTF-8"); } catch (Exception e) { return s; }
    }

    @Override
    public void destroy() {
        if (client != null) {
            try { client.dispatcher().executorService().shutdown(); } catch (Exception ignore) { }
            try { client.connectionPool().evictAll(); } catch (Exception ignore) { }
            client = null;
        }
    }
}
